        "flistxattr",
        "setxattr",
        "lsetxattr",
        "fsetxattr",
        "removexattr",
        "lremovexattr",
        "fremovexattr"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_group": "FILE-DESCRIPTOR \u2014 dup, pipe, fcntl, inotify, eventfd, memfd",
      "names": [
        "dup",
        "dup2",
        "dup3",
