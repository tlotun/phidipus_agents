        "shmctl",
        "shmdt"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_group": "EXPLICIT DENY \u2014 clone with namespace flags (Bug #7 fix: defence-in-depth)",
      "_note": "Blocks clone() when CLONE_NEWUSER (0x10000000) or CLONE_NEWNS (0x00020000) flags are set. Prevents user-namespace container escape on permissive kernels. Placed BEFORE the PROCESS ALLOW rule so seccomp first-match selects this deny.",
      "names": [
        "clone"
      ],
      "action": "SCMP_ACT_ERRNO",
      "args": [
        {
          "index": 0,
          "value": 268435456,
          "valueTwo": 268435456,
          "op": "SCMP_CMP_MASKED_EQ"
        }
      ]
    },
    {
      "_group": "EXPLICIT DENY \u2014 clone with CLONE_NEWNS (Bug #7 fix)",
      "names": [
        "clone"
      ],
      "action": "SCMP_ACT_ERRNO",
      "args": [
        {
          "index": 0,
          "value": 131072,
          "valueTwo": 131072,
          "op": "SCMP_CMP_MASKED_EQ"
        }
      ]
    },
    {
