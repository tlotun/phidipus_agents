    {
      "_group": "MEMORY \u2014 mmap, brk, mprotect, mremap, madvise, huge pages, SHM",
      "names": [
        "brk",
        "mmap",
        "munmap",
        "mremap",
        "mprotect",
        "mlock",
        "mlock2",
        "munlock",
