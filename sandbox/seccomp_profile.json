{
  "_comment": "Phidipus v1.0 \u2014 sandbox/seccomp_profile.json. Enforces R-11 through R-16. Default-deny: every syscall not in the allowlist is rejected with SCMP_ACT_ERRNO(EPERM). Network syscalls, namespace ops, module loading, privilege escalation, and raw-socket syscalls are explicitly listed below the allowlist for auditability.",
  "defaultAction": "SCMP_ACT_ERRNO",
  "architectures": [
    "SCMP_ARCH_X86_64",
    "SCMP_ARCH_X86",
    "SCMP_ARCH_X32"
  ],
  "syscalls": [
